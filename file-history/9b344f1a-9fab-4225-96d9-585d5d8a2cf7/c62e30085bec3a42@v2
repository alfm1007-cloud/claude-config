param(
  [string]$Action = 'none',   # none | click | rclick | paste | key
  [int]$X = 0, [int]$Y = 0,   # coordinates RELATIVE to the CurseForge window's top-left
  [string]$Text = '',         # text for paste, or key spec for SendKeys (e.g. '{ENTER}', '^a')
  [int]$WaitMs = 800,
  [string]$Out = '',
  [int]$PreWaitMs = 1500,     # let the Claude approval dialog settle before grabbing focus
  [switch]$Release            # remove always-on-top from CurseForge and exit
)
Add-Type -AssemblyName System.Drawing, System.Windows.Forms
Add-Type @"
using System; using System.Runtime.InteropServices;
public class W {
  [DllImport("user32.dll")] public static extern bool SetProcessDPIAware();
  [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr h);
  [DllImport("user32.dll")] public static extern bool BringWindowToTop(IntPtr h);
  [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr h, int c);
  [DllImport("user32.dll")] public static extern bool IsIconic(IntPtr h);
  [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
  [DllImport("user32.dll")] public static extern bool GetWindowRect(IntPtr h, out RECT r);
  [DllImport("user32.dll")] public static extern bool SetCursorPos(int x, int y);
  [DllImport("user32.dll")] public static extern void mouse_event(uint f, uint dx, uint dy, uint d, UIntPtr e);
  [DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte sc, uint f, UIntPtr e);
  [DllImport("user32.dll")] public static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int cx, int cy, uint f);
  [DllImport("user32.dll")] public static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);
  [StructLayout(LayoutKind.Sequential)] public struct RECT { public int Left, Top, Right, Bottom; }
}
"@
[void][W]::SetProcessDPIAware()
$p = Get-Process CurseForge -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -ne 0 -and $_.MainWindowTitle -eq 'CurseForge' } | Select-Object -First 1
if (-not $p) { 'ERROR: CurseForge window not found'; exit 1 }
$h = $p.MainWindowHandle
if ($Release) { [void][W]::SetWindowPos($h, [IntPtr](-2), 0, 0, 0, 0, 0x0013); 'released always-on-top'; exit 0 }
Start-Sleep -Milliseconds $PreWaitMs
if ([W]::IsIconic($h)) { [void][W]::ShowWindow($h, 9); Start-Sleep -Milliseconds 900 }
[void][W]::SetWindowPos($h, [IntPtr](-1), 0, 0, 0, 0, 0x0013)   # HWND_TOPMOST, no move/size/activate
[W]::keybd_event(0x12, 0, 0, [UIntPtr]::Zero); [W]::keybd_event(0x12, 0, 2, [UIntPtr]::Zero)   # Alt tap unlocks SetForegroundWindow
[void][W]::ShowWindow($h, 5); [void][W]::BringWindowToTop($h); [void][W]::SetForegroundWindow($h)
Start-Sleep -Milliseconds 300
$fgh = [W]::GetForegroundWindow(); [uint32]$fgpid = 0; [void][W]::GetWindowThreadProcessId($fgh, [ref]$fgpid)
$cfPids = @(Get-Process CurseForge -ErrorAction SilentlyContinue | ForEach-Object { [uint32]$_.Id })
$fg = ($fgh -eq $h) -or ($cfPids -contains $fgpid)   # main window or one of its popups (e.g. context menu)
$r = New-Object W+RECT; [void][W]::GetWindowRect($h, [ref]$r)
"window rect: $($r.Left),$($r.Top) - $($r.Right),$($r.Bottom)  foreground=$fg"
if (-not $fg) { 'ERROR: could not bring CurseForge to foreground; no action taken'; exit 2 }
$sx = $r.Left + $X; $sy = $r.Top + $Y
switch ($Action) {
  'click'  { [void][W]::SetCursorPos($sx, $sy); Start-Sleep -Milliseconds 80; [W]::mouse_event(2,0,0,0,[UIntPtr]::Zero); [W]::mouse_event(4,0,0,0,[UIntPtr]::Zero); "clicked at window($X,$Y) screen($sx,$sy)" }
  'rclick' { [void][W]::SetCursorPos($sx, $sy); Start-Sleep -Milliseconds 80; [W]::mouse_event(8,0,0,0,[UIntPtr]::Zero); [W]::mouse_event(16,0,0,0,[UIntPtr]::Zero); "right-clicked at window($X,$Y) screen($sx,$sy)" }
  'paste'  { Set-Clipboard -Value $Text; Start-Sleep -Milliseconds 100; [System.Windows.Forms.SendKeys]::SendWait('^v'); "pasted $($Text.Length) chars" }
  'key'    { [System.Windows.Forms.SendKeys]::SendWait($Text); "sent keys $Text" }
  default  { 'no action' }
}
Start-Sleep -Milliseconds $WaitMs
if ($Out) {
  [void][W]::GetWindowRect($h, [ref]$r)
  $w = $r.Right - $r.Left; $hh = $r.Bottom - $r.Top
  $bmp = New-Object System.Drawing.Bitmap $w, $hh
  $g = [System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($r.Left, $r.Top, 0, 0, $bmp.Size); $g.Dispose()
  $bmp.Save($Out, [System.Drawing.Imaging.ImageFormat]::Png); $bmp.Dispose()
  "saved $Out ($w x $hh)"
}
