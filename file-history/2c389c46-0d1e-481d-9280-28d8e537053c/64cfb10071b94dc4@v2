// 테스트용 '다른 프로그램' 창: 받은 키를 파일에 적고 정해진 시간 뒤 닫힌다
using System;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

static class KeyReceiver
{
    [STAThread]
    static void Main(string[] a)
    {
        string log = a[0];
        int sec = int.Parse(a[1]);
        var f = new Form { Text = "KeyReceiver", TopMost = true, KeyPreview = true, StartPosition = FormStartPosition.Manual,
                           Location = new Point(800, 200), Size = new Size(320, 200) };
        f.Controls.Add(new Label { Text = "다른 프로그램 역할 (테스트)", AutoSize = true, Location = new Point(20, 20) });
        f.KeyDown += delegate (object s, KeyEventArgs e) { File.AppendAllText(log, e.KeyCode + Environment.NewLine); };
        var t = new Timer { Interval = sec * 1000 };
        t.Tick += delegate { f.Close(); };
        t.Start();
        Application.Run(f);
    }
}
