$ErrorActionPreference = 'Stop'
$dir = 'C:\Users\alfm1\Desktop\Claude\halligalli-bell'
$ini = Join-Path $dir 'HalliBell.ini'
$log = Join-Path $dir 'HalliBell.log'

Add-Type -ReferencedAssemblies System.Windows.Forms, System.Drawing -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Drawing;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using System.Windows.Forms;

public static class Harness
{
    [StructLayout(LayoutKind.Sequential)] struct MOUSEINPUT { public int dx, dy; public uint mouseData, dwFlags, time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Sequential)] struct KEYBDINPUT { public ushort wVk, wScan; public uint dwFlags, time; public IntPtr dwExtraInfo; }
    [StructLayout(LayoutKind.Explicit)] struct U { [FieldOffset(0)] public MOUSEINPUT mi; [FieldOffset(0)] public KEYBDINPUT ki; }
    [StructLayout(LayoutKind.Sequential)] struct INPUT { public uint type; public U u; }
    [StructLayout(LayoutKind.Sequential)] struct POINT { public int X, Y; }
    [DllImport("user32.dll")] static extern uint SendInput(uint n, INPUT[] i, int size);
    [DllImport("user32.dll")] static extern bool SetCursorPos(int x, int y);
    [DllImport("user32.dll")] static extern bool GetCursorPos(out POINT p);
    [DllImport("user32.dll")] static extern int GetSystemMetrics(int i);
    [DllImport("user32.dll")] static extern uint MapVirtualKey(uint code, uint type);
    [DllImport("shcore.dll")] static extern int SetProcessDpiAwareness(int v);

    static Stopwatch sw = Stopwatch.StartNew();
    static void Wait(int ms) { long end = sw.ElapsedMilliseconds + ms; while (sw.ElapsedMilliseconds < end) Application.DoEvents(); }
    static void Key(Keys k, bool up)
    {
        var i = new INPUT { type = 1 };
        i.u.ki.wVk = (ushort)k; i.u.ki.wScan = (ushort)MapVirtualKey((uint)k, 0); i.u.ki.dwFlags = up ? 2u : 0u;
        SendInput(1, new[] { i }, Marshal.SizeOf(typeof(INPUT)));
    }
    static void Tap(Keys k) { Key(k, false); Wait(30); Key(k, true); }
    static void ClickAt(Point p)
    {
        long l = GetSystemMetrics(76), t = GetSystemMetrics(77), w = GetSystemMetrics(78), h = GetSystemMetrics(79);
        var a = new INPUT[2];
        for (int n = 0; n < 2; n++)
        {
            a[n].type = 0;
            a[n].u.mi.dx = (int)(((p.X - l) * 65536 + w - 1) / w);
            a[n].u.mi.dy = (int)(((p.Y - t) * 65536 + h - 1) / h);
            a[n].u.mi.dwFlags = 0x0001u | 0x8000u | 0x4000u | (n == 0 ? 0x0002u : 0x0004u);
        }
        SendInput(2, a, Marshal.SizeOf(typeof(INPUT)));
    }
    static Point Cur() { POINT p; GetCursorPos(out p); return new Point(p.X, p.Y); }
    static string Stat(List<double> v)
    {
        if (v.Count == 0) return "(측정 0건)";
        double min = double.MaxValue, max = 0, sum = 0;
        foreach (double d in v) { min = Math.Min(min, d); max = Math.Max(max, d); sum += d; }
        return string.Format("{0:0.00}~{1:0.00}ms (평균 {2:0.00}, {3}건)", min, max, sum / v.Count, v.Count);
    }
    static string Saved(string iniPath)
    {
        var saved = new List<string>();
        foreach (string l in File.ReadAllLines(iniPath, Encoding.UTF8))
            foreach (string k in new[] { "TargetProcess=", "WindowWidth=", "WindowHeight=", "BellX=", "BellY=", "CardX=", "CardY=" })
                if (l.StartsWith(k)) saved.Add(l);
        return string.Join(" ", saved.ToArray());
    }

    public static string Run(string iniPath)
    {
        try { SetProcessDpiAwareness(2); } catch (Exception) { }
        var log = new StringBuilder();
        Point userCursor = Cur();

        var f = new Form { Text = "HalliBell 자동 테스트 (몇 초 뒤 닫힘)", TopMost = true, KeyPreview = true,
                           StartPosition = FormStartPosition.Manual, Location = new Point(200, 200), ClientSize = new Size(520, 260) };
        var bellBtn = new Button { Text = "BELL", Location = new Point(20, 20), Size = new Size(140, 90), TabStop = false };
        var cardBtn = new Button { Text = "CARD", Location = new Point(20, 140), Size = new Size(140, 90), TabStop = false };
        var note = new Label { Text = "자동 테스트 중\r\n마우스·키보드에서\r\n손 떼 주세요 (약 10초)", Location = new Point(190, 110), AutoSize = true,
                               Font = new Font("Malgun Gothic", 14, FontStyle.Bold), ForeColor = Color.Firebrick };
        f.Controls.Add(bellBtn); f.Controls.Add(cardBtn); f.Controls.Add(note);
        var bellDowns = new List<double>(); var cardDowns = new List<double>();
        int spaceToApp = 0, fToApp = 0;
        bellBtn.MouseDown += delegate { bellDowns.Add(sw.Elapsed.TotalMilliseconds); };
        cardBtn.MouseDown += delegate { cardDowns.Add(sw.Elapsed.TotalMilliseconds); };
        f.KeyDown += delegate (object s, KeyEventArgs e) { if (e.KeyCode == Keys.Space) spaceToApp++; if (e.KeyCode == Keys.F) fToApp++; };
        f.Show();
        Wait(2000); // 안내를 읽고 손 뗄 시간
        ClickAt(f.PointToScreen(new Point(450, 230))); // 빈 곳 클릭 → 앞 창으로
        Wait(300);

        Point bell = bellBtn.PointToScreen(new Point(70, 45));
        Point card = cardBtn.PointToScreen(new Point(70, 45));
        Point rest = f.PointToScreen(new Point(420, 60));

        // 1) F7 종 / F6 카드 저장
        SetCursorPos(bell.X, bell.Y); Wait(50); Tap(Keys.F7); Wait(400);
        SetCursorPos(card.X, card.Y); Wait(50); Tap(Keys.F6); Wait(400);
        log.AppendLine("[F7·F6 저장] " + Saved(iniPath) + "  (기대: BellX=90 BellY=65 CardX=90 CardY=185)");

        // 2) Space 10회 → 종, F 10회 → 카드
        foreach (var t in new[] { new { K = Keys.Space, N = "Space→종" }, new { K = Keys.F, N = "F→카드" } })
        {
            var mine = t.K == Keys.Space ? bellDowns : cardDowns;
            var other = t.K == Keys.Space ? cardDowns : bellDowns;
            var lat = new List<double>();
            int returned = 0, wrong = 0, leaked0 = spaceToApp + fToApp, moved = 0;
            for (int n = 0; n < 10; n++)
            {
                SetCursorPos(rest.X, rest.Y); Wait(40);
                Point pre = Cur();
                if (pre != rest) { moved++; log.AppendLine("  #" + n + " 키 누르기 전 이미 커서가 움직임(실제 마우스): " + pre); }
                int before = mine.Count, otherBefore = other.Count; double t0 = sw.Elapsed.TotalMilliseconds;
                Key(t.K, false); Wait(50); Key(t.K, true); Wait(150);
                if (mine.Count > before) lat.Add(mine[before] - t0);
                wrong += other.Count - otherBefore;
                Point c = Cur();
                if (Math.Abs(c.X - rest.X) <= 1 && Math.Abs(c.Y - rest.Y) <= 1) returned++;
                else log.AppendLine("  복귀 실패 #" + n + ": 커서=" + c + " 기대=" + rest);
            }
            log.AppendLine("[" + t.N + " x10] 맞는 버튼 클릭 " + lat.Count + "/10, 다른 버튼 클릭 " + wrong + "(기대 0), 커서 복귀 " + returned + "/10, 앱에 새어나간 키 " + (spaceToApp + fToApp - leaked0) + "(기대 0), 실제 마우스 개입 " + moved + "회");
            log.AppendLine("[" + t.N + " x10] 키 누름 → 버튼 눌림: " + Stat(lat));
        }

        // 3) 꾹 누름 (반복 입력 3번 + 뗌) → 1번만
        SetCursorPos(rest.X, rest.Y); Wait(40);
        int b3 = bellDowns.Count;
        Key(Keys.Space, false); Wait(40); Key(Keys.Space, false); Wait(40); Key(Keys.Space, false); Wait(40); Key(Keys.Space, true); Wait(150);
        log.AppendLine("[Space 꾹 누름] 종 클릭 " + (bellDowns.Count - b3) + "회(기대 1)");

        // 4) F8 끄기 → 클릭 없음, 키는 앱에 그대로
        Tap(Keys.F8); Wait(250);
        int b4 = bellDowns.Count + cardDowns.Count, k4 = spaceToApp + fToApp;
        SetCursorPos(rest.X, rest.Y); Wait(30);
        Tap(Keys.Space); Wait(150); Tap(Keys.F); Wait(150);
        log.AppendLine("[F8 끔] 클릭 " + (bellDowns.Count + cardDowns.Count - b4) + "회(기대 0), 앱에 간 키 " + (spaceToApp + fToApp - k4) + "개(기대 2)");

        // 5) F8 다시 켜기 → 클릭 1회
        Tap(Keys.F8); Wait(250);
        int b5 = bellDowns.Count;
        SetCursorPos(rest.X, rest.Y); Wait(30);
        Tap(Keys.Space); Wait(200);
        log.AppendLine("[F8 켬] 종 클릭 " + (bellDowns.Count - b5) + "회(기대 1)");

        // 6) 창 크기 변경 → 클릭 거부 (엉뚱한 곳 안 누름), 원래 크기로 돌리면 다시 동작
        f.ClientSize = new Size(500, 260); Wait(300);
        int b6 = bellDowns.Count, k6 = spaceToApp;
        SetCursorPos(rest.X, rest.Y); Wait(30);
        Tap(Keys.Space); Wait(200);
        log.AppendLine("[창 크기 바뀜] 종 클릭 " + (bellDowns.Count - b6) + "회(기대 0), 앱에 간 Space " + (spaceToApp - k6) + "개(기대 1)");
        f.ClientSize = new Size(520, 260); Wait(300);
        int b7 = bellDowns.Count;
        SetCursorPos(rest.X, rest.Y); Wait(30);
        Tap(Keys.Space); Wait(200);
        log.AppendLine("[원래 크기] 종 클릭 " + (bellDowns.Count - b7) + "회(기대 1)");

        f.Close();
        SetCursorPos(userCursor.X, userCursor.Y);
        return log.ToString();
    }
}
'@

if (Get-Process HalliBell -ErrorAction SilentlyContinue) { throw "HalliBell이 이미 실행 중 — 사용자 설정 보호를 위해 테스트 중단" }
# 사용자 설정은 지우지 않고 백업 → 테스트 끝나면 복원
$backup = "$ini.test_backup"
$hadIni = Test-Path $ini
if ($hadIni) { Copy-Item $ini $backup -Force }
$hadLog = Test-Path $log
if ($hadLog) { Copy-Item $log "$log.test_backup" -Force }
Remove-Item $ini, $log -ErrorAction SilentlyContinue
$p = Start-Process (Join-Path $dir 'HalliBell.exe') -PassThru
Start-Sleep -Milliseconds 1500
try {
    [Harness]::Run($ini)
} finally {
    Stop-Process -Id $p.Id -ErrorAction SilentlyContinue
    Start-Sleep -Milliseconds 300
    Remove-Item $ini, $log -ErrorAction SilentlyContinue
    if ($hadIni) { Move-Item $backup $ini -Force }
    if ($hadLog) { Move-Item "$log.test_backup" $log -Force }
}
