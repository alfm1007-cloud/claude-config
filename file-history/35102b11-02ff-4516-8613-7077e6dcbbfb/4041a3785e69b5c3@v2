param([int]$Count = 30, [string]$Label = "", [int]$Seed = 7)
# Presses F-keys in Roblox (DjSpeed must be running) and reads the slider knob back from the screen.
. "$PSScriptRoot\rbx_common.ps1"
if (-not (Focus-Roblox)) { "NOT_FOREGROUND"; exit 1 }
$hwnd = Get-RobloxHwnd

function Read-Level {
  $bmp = Grab 100 561 260 4   # rows 561..564 hold only the knob ring (track is at 570..573)
  $min = 9999; $max = -1
  for ($yy = 0; $yy -lt 4; $yy++) { for ($xx = 0; $xx -lt 260; $xx++) {
    if (Is-Bluish $bmp.GetPixel($xx, $yy)) { if ($xx -lt $min) { $min = $xx }; if ($xx -gt $max) { $max = $xx } } } }
  $bmp.Dispose()
  if ($max -lt 0) { return -1 }
  return [int][Math]::Round(((($min + $max) / 2 + 100) - 127) / 19.9)
}

$vk = @{ 0 = 0x7B; 1 = 0x70; 2 = 0x71; 3 = 0x72; 4 = 0x73; 5 = 0x74; 6 = 0x75; 7 = 0x76; 8 = 0x77; 9 = 0x78; 10 = 0x79 }
$pool = @(2, 3, 2, 3, 2, 3, 1, 4, 5, 6, 7, 8, 9, 10, 0)
$rng = New-Object System.Random $Seed
$start = Read-Level; $cur = $start
$ok = 0; $fails = @(); $tries = @{ L = 0; R = 0 }; $wins = @{ L = 0; R = 0 }
for ($i = 0; $i -lt $Count; $i++) {
  do { $t = $pool[$rng.Next($pool.Count)] } while ($t -eq $cur)
  [R]::SetCursorPos(200, 540) | Out-Null   # empty spot on the panel
  Start-Sleep -Milliseconds 150
  if ([R]::GetForegroundWindow() -ne $hwnd) { "LOST_FOCUS at trial $i"; break }
  [R]::keybd_event($vk[$t], 0, 0, [UIntPtr]::Zero); [R]::keybd_event($vk[$t], 0, 2, [UIntPtr]::Zero)
  Start-Sleep -Milliseconds 450
  $got = Read-Level
  $dir = if ($t -lt $cur) { "L" } else { "R" }
  $tries[$dir]++
  if ($got -eq $t) { $ok++; $wins[$dir]++ } else { $fails += "$cur->$t got $got" }
  $cur = $got
}
"$Label  ok=$ok/$Count  (left $($wins.L)/$($tries.L), right $($wins.R)/$($tries.R))  fails: " + ($fails -join "; ")
# put the speed back where it was
if ($start -ge 0 -and [R]::GetForegroundWindow() -eq $hwnd) {
  [R]::keybd_event($vk[$start], 0, 0, [UIntPtr]::Zero); [R]::keybd_event($vk[$start], 0, 2, [UIntPtr]::Zero)
  Start-Sleep -Milliseconds 450
  "restored: " + (Read-Level)
}
