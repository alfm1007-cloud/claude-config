param([string]$Steps = "F5:5,E:6,E:7,Q:6,T:0,E:1,F6:6", [int]$ParkX = 93, [int]$ParkY = 574)
# Presses each key in Roblox and checks the settled slider value. Steps: "KEY:expected,..."
. "$PSScriptRoot\rbx_common.ps1"
if (-not (Focus-Roblox)) { "NOT_FOREGROUND"; exit 1 }
$hwnd = Get-RobloxHwnd
function Read-Pos {
  $bmp = Grab 100 561 260 4
  $min = 9999; $max = -1
  for ($yy = 0; $yy -lt 4; $yy++) { for ($xx = 0; $xx -lt 260; $xx++) {
    if (Is-Bluish $bmp.GetPixel($xx, $yy)) { if ($xx -lt $min) { $min = $xx }; if ($xx -gt $max) { $max = $xx } } } }
  $bmp.Dispose()
  if ($max -lt 0) { return -99 }
  return ((($min + $max) / 2 + 100) - 127) / 19.9
}
function Read-Stable {
  $sw = [Diagnostics.Stopwatch]::StartNew(); $last = Read-Pos; $since = 0
  while ($sw.ElapsedMilliseconds -lt 2000) {
    Start-Sleep -Milliseconds 40
    $v = Read-Pos
    if ([Math]::Abs($v - $last) -lt 0.05) { $since += 40; if ($since -ge 240 -and $sw.ElapsedMilliseconds -ge 700) { break } } else { $since = 0 }
    $last = $v
  }
  return [int][Math]::Round($last)
}
$vk = @{ F1 = 0x70; F2 = 0x71; F3 = 0x72; F4 = 0x73; F5 = 0x74; F6 = 0x75; F7 = 0x76; F8 = 0x77; F9 = 0x78; F10 = 0x79; F12 = 0x7B; Q = 0x51; E = 0x45; T = 0x54 }
$out = @(); $ok = 0; $n = 0
foreach ($s in $Steps.Split(',')) {
  $k, $want = $s.Split(':'); $want = [int]$want; $n++
  [R]::SetCursorPos($ParkX, $ParkY) | Out-Null; Start-Sleep -Milliseconds 200
  if ([R]::GetForegroundWindow() -ne $hwnd) { $out += "LOST_FOCUS"; break }
  [R]::keybd_event($vk[$k], 0, 0, [UIntPtr]::Zero); [R]::keybd_event($vk[$k], 0, 2, [UIntPtr]::Zero)
  $got = Read-Stable
  if ($got -eq $want) { $ok++; $out += "$k=$got o" } else { $out += "$k=$got x(want $want)" }
}
"ok=$ok/$n  " + ($out -join "  ")
