param([int]$Interval = 1000, [int]$Count = 10, [int]$A = 3, [int]$B = 8)
# Alternates F<A>/F<B> at a fixed interval and checks whether the knob reached each target before the next press.
. "$PSScriptRoot\rbx_common.ps1"
if (-not (Focus-Roblox)) { "NOT_FOREGROUND"; exit 1 }
$hwnd = Get-RobloxHwnd
function Read-Pos {
  $bmp = Grab 100 561 260 4
  $min = 9999; $max = -1
  for ($yy = 0; $yy -lt 4; $yy++) { for ($xx = 0; $xx -lt 260; $xx++) {
    if (Is-Bluish $bmp.GetPixel($xx, $yy)) { if ($xx -lt $min) { $min = $xx }; if ($xx -gt $max) { $max = $xx } } } }
  $bmp.Dispose()
  if ($max -lt 0) { return -99 }
  return ((($min + $max) / 2 + 100) - 127) / 19.9
}
$vk = @{ 0 = 0x7B; 1 = 0x70; 2 = 0x71; 3 = 0x72; 4 = 0x73; 5 = 0x74; 6 = 0x75; 7 = 0x76; 8 = 0x77; 9 = 0x78; 10 = 0x79 }
$start = [int][Math]::Round((Read-Pos))
# first press to a known state, then wait long
[R]::SetCursorPos(200, 540) | Out-Null
[R]::keybd_event($vk[$B], 0, 0, [UIntPtr]::Zero); [R]::keybd_event($vk[$B], 0, 2, [UIntPtr]::Zero)
Start-Sleep -Milliseconds 3000
$seq = ""; $ok = 0
for ($i = 0; $i -lt $Count; $i++) {
  $t = if ($i % 2 -eq 0) { $A } else { $B }
  if ([R]::GetForegroundWindow() -ne $hwnd) { "LOST_FOCUS"; break }
  $sw = [Diagnostics.Stopwatch]::StartNew()
  [R]::keybd_event($vk[$t], 0, 0, [UIntPtr]::Zero); [R]::keybd_event($vk[$t], 0, 2, [UIntPtr]::Zero)
  while ($sw.ElapsedMilliseconds -lt $Interval - 60) { Start-Sleep -Milliseconds 10 }
  $v = Read-Pos
  if ([Math]::Abs($v - $t) -lt 0.6) { $ok++; $seq += "o" } else { $seq += "x" }
  while ($sw.ElapsedMilliseconds -lt $Interval) { Start-Sleep -Milliseconds 5 }
}
"interval={0}ms  ok={1}/{2}  seq={3}" -f $Interval, $ok, $Count, $seq
if ([R]::GetForegroundWindow() -eq $hwnd) {
  Start-Sleep -Milliseconds 1500
  [R]::keybd_event($vk[$start], 0, 0, [UIntPtr]::Zero); [R]::keybd_event($vk[$start], 0, 2, [UIntPtr]::Zero)
}
