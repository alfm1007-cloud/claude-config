param([string]$OutFile)
# Test window: becomes foreground, sends keys to itself, records which keys actually arrived.
Add-Type -AssemblyName System.Windows.Forms
Add-Type @"
using System; using System.Runtime.InteropServices;
public static class W {
  [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
  [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr h);
  [DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte scan, uint flags, UIntPtr extra);
}
"@
$got = New-Object System.Collections.Generic.List[string]
$state = @{ step = 0; result = "TIMEOUT" }
$f = New-Object System.Windows.Forms.Form
$f.Text = "DjSpeed test"; $f.TopMost = $true; $f.KeyPreview = $true
$f.Width = 320; $f.Height = 120; $f.StartPosition = 'CenterScreen'
$tb = New-Object System.Windows.Forms.TextBox; $tb.Dock = 'Fill'; $f.Controls.Add($tb)
$f.Add_KeyDown({ param($s, $e) $got.Add($e.KeyCode.ToString()); $e.SuppressKeyPress = $true })
$f.Add_KeyUp({ param($s, $e) $e.Handled = $true })
$t = New-Object System.Windows.Forms.Timer; $t.Interval = 400
$t.Add_Tick({
  $t.Stop()
  if ($state.step -eq 0) {
    [W]::SetForegroundWindow($f.Handle) | Out-Null
    if ([W]::GetForegroundWindow() -ne $f.Handle) { $state.result = "NOT_FOREGROUND"; $f.Close(); return }
    [System.Windows.Forms.SendKeys]::SendWait("{F5}{F12}{SUBTRACT}{ADD}{ADD}{F11}{F10}{ADD}{F1}a")
    # F3 held down: two key-downs (auto-repeat) then one key-up
    [W]::keybd_event(0x72, 0, 0, [UIntPtr]::Zero)
    [W]::keybd_event(0x72, 0, 0, [UIntPtr]::Zero)
    [W]::keybd_event(0x72, 0, 2, [UIntPtr]::Zero)
    $state.step = 1; $t.Start()
  } else { $state.result = "OK"; $f.Close() }
})
$f.Add_Shown({ $f.Activate(); $t.Start() })
[System.Windows.Forms.Application]::Run($f)
($state.result + ": " + ($got -join ",")) | Set-Content $OutFile
