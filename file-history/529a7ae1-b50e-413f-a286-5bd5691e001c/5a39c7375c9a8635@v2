        };
        combo.SelectionChangeCommitted += delegate { OnSelect(); };
        table.Controls.Add(combo, 1, 0);
        Button refreshBtn = MakeButton("새로고침");
        refreshBtn.Click += delegate { RefreshWindows(); };
