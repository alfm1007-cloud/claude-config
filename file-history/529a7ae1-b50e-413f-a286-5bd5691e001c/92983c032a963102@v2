"""최소화 상태 클릭에 필요한 대기 시간 측정. exe와 같은 입력 순서를 파이썬으로 재현해 조합별로 반복.
판정: 채팅 아이콘이 채워짐(켜짐)/테두리(꺼짐) → 클릭 전후로 바뀌었으면 성공."""
import ctypes
import sys
import time
from ctypes import wintypes

from rbx_lib import capture, cm, roblox_hwnd, u

X, Y = 139, 35


class MOUSEINPUT(ctypes.Structure):
    _fields_ = [("dx", ctypes.c_long), ("dy", ctypes.c_long), ("mouseData", wintypes.DWORD),
                ("dwFlags", wintypes.DWORD), ("time", wintypes.DWORD), ("dwExtraInfo", ctypes.c_size_t)]


class INPUT(ctypes.Structure):
    _fields_ = [("type", wintypes.DWORD), ("mi", MOUSEINPUT)]


u.SendInput.argtypes = [wintypes.UINT, ctypes.POINTER(INPUT), ctypes.c_int]
u.GetSystemMetrics.argtypes = [ctypes.c_int]
SL, ST, SW, SH = (u.GetSystemMetrics(i) for i in (76, 77, 78, 79))
ABS, DOWN, UP = 0x0001 | 0x8000 | 0x4000, 0x0002, 0x0004


def send(x, y, flags):
    inp = INPUT(0, MOUSEINPUT(((x - SL) * 65536 + SW - 1) // SW, ((y - ST) * 65536 + SH - 1) // SH, 0, ABS | flags, 0, 0))
    u.SendInput(1, ctypes.byref(inp), ctypes.sizeof(INPUT))


def pin(x, y, sec, wiggle):
    until = time.monotonic() + sec
    nudge = wiggle
    while time.monotonic() < until:
        send(x + (1 if nudge else 0), y, 0)
        if wiggle:
            nudge = not nudge
        time.sleep(0.01)


def click_seq(h, restore_wait, hover, hold):
    prev_fg = u.GetForegroundWindow()
    prev = wintypes.POINT()
    u.GetCursorPos(ctypes.byref(prev))
    was_min = bool(u.IsIconic(h))
    try:
        if was_min:
            u.ShowWindow(h, cm.SW_RESTORE)
            time.sleep(restore_wait)
        if not cm._activate(h):
            return "앞으로 못 가져옴"
        pt = wintypes.POINT(X, Y)
        u.ClientToScreen(h, ctypes.byref(pt))
        deadline = time.monotonic() + 0.5
        while u.GetAncestor(u.WindowFromPoint(pt), cm.GA_ROOT) != h:
            if time.monotonic() > deadline:
                return "가려짐"
            time.sleep(0.01)
        pin(pt.x, pt.y, hover, True)
        send(pt.x, pt.y, DOWN)
        pin(pt.x, pt.y, hold, False)
        send(pt.x, pt.y, UP)
        time.sleep(0.05)
        return "ok"
    finally:
        if was_min:
            u.ShowWindow(h, cm.SW_MINIMIZE)
        u.SetCursorPos(prev.x, prev.y)
        if prev_fg and prev_fg != h and u.IsWindow(prev_fg):
            cm._activate(prev_fg)


def chat_on(h):
    box = capture(h, "timing_tmp.png")[0].convert("L").crop((133, 28, 146, 39)).tobytes()
    return sum(1 for v in box if v > 200) / len(box) > 0.45


def show_noactivate(h):
    fg = u.GetForegroundWindow()
    u.ShowWindow(h, 4)
    time.sleep(0.9)
    if fg and fg != h:
        cm._activate(fg)


h = roblox_hwnd()
if u.IsIconic(h):
    show_noactivate(h)
state = chat_on(h)
print("시작 상태: 채팅", "켜짐" if state else "꺼짐")

# (이름, 최소화 여부, 최소화 유지 시간, 복원 대기, 붙잡기, 누름 유지, 횟수)
PLANS = {
    "A": ("현재값 0.3/0.15/0.08", True, 3, 0.3, 0.15, 0.08, 5),
    "B": ("늘림 0.6/0.30/0.15", True, 3, 0.6, 0.30, 0.15, 5),
    "C": ("늘림 + 20초 최소화", True, 20, 0.6, 0.30, 0.15, 2),
    "N": ("최소화 아님, 짧게 0.15/0.08", False, 0, 0.3, 0.15, 0.08, 6),
    "N2": ("최소화 아님, 길게 0.30/0.15", False, 0, 0.3, 0.30, 0.15, 6),
    "N3": ("최소화 아님, 붙잡기만 길게 0.30/0.08", False, 0, 0.3, 0.30, 0.08, 6),
    "N4": ("최소화 아님, 누름만 길게 0.15/0.15", False, 0, 0.3, 0.15, 0.15, 6),
}
for key in sys.argv[1:]:
    name, minimize, dwell, rw, hv, hd, count = PLANS[key]
    ok = 0
    detail = []
    for _ in range(count):
        if minimize:
            u.ShowWindow(h, cm.SW_MINIMIZE)
            time.sleep(dwell)
        t0 = time.monotonic()
        res = click_seq(h, rw, hv, hd)
        took = time.monotonic() - t0
        if minimize:
            show_noactivate(h)
        else:
            time.sleep(0.9)
        new = chat_on(h)
        hit = res == "ok" and new != state
        ok += hit
        detail.append(f"{'O' if hit else 'X'}{'켜기' if not state else '끄기'}({took:.2f}s)" + ("" if res == "ok" else f"[{res}]"))
        state = new
    print(f"{key} {name}: 성공 {ok}/{count}  {' '.join(detail)}")

if not state:      # 끝낼 때는 처음처럼 채팅 켜짐으로
    for _ in range(3):
        click_seq(h, 0.6, 0.30, 0.15)
        time.sleep(0.9)
        state = chat_on(h)
        if state:
            break
print("종료 상태: 채팅", "켜짐" if state else "꺼짐")
