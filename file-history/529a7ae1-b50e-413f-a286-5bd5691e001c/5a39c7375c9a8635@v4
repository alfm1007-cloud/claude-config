static class Native
{
    public const int VK_TOGGLE = 0x77;      // F8: 시작/정지
    public const int VK_CAPTURE = 0x76;     // F7: 클릭 위치 저장
    public const byte VK_MENU = 0x12;
    public const uint INPUT_MOUSE = 0;
    public const uint INPUT_KEYBOARD = 1;
    public const uint KEYEVENTF_EXTENDEDKEY = 0x0001;
    public const uint KEYEVENTF_KEYUP = 0x0002;
    public const uint KEYEVENTF_SCANCODE = 0x0008;
    public const uint MOUSEEVENTF_MOVE = 0x0001;
    public const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
    public const uint MOUSEEVENTF_LEFTUP = 0x0004;
    public const uint MOUSEEVENTF_VIRTUALDESK = 0x4000;
    public const uint MOUSEEVENTF_ABSOLUTE = 0x8000;
    public const int SM_XVIRTUALSCREEN = 76;
    public const int SM_YVIRTUALSCREEN = 77;
    public const int SM_CXVIRTUALSCREEN = 78;
    public const int SM_CYVIRTUALSCREEN = 79;
    public const int SW_MINIMIZE = 6;
    public const int SW_RESTORE = 9;
    public const uint GA_ROOT = 2;
    public const uint DWMWA_CLOAKED = 14;
    public const uint PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;

    [StructLayout(LayoutKind.Sequential)]
    public struct POINT { public int X, Y; }

    [StructLayout(LayoutKind.Sequential)]
    public struct RECT { public int Left, Top, Right, Bottom; }

    [StructLayout(LayoutKind.Sequential)]
    public struct MOUSEINPUT { public int dx, dy; public uint mouseData, dwFlags, time; public UIntPtr dwExtraInfo; }

    [StructLayout(LayoutKind.Sequential)]
    public struct KEYBDINPUT { public ushort wVk, wScan; public uint dwFlags, time; public UIntPtr dwExtraInfo; }

    [StructLayout(LayoutKind.Explicit)]
    public struct InputUnion
    {
        [FieldOffset(0)] public MOUSEINPUT mi;
        [FieldOffset(0)] public KEYBDINPUT ki;
    }

    [StructLayout(LayoutKind.Sequential)]
    public struct INPUT { public uint type; public InputUnion u; }

    public delegate bool EnumWindowsProc(IntPtr hwnd, IntPtr lParam);

    [DllImport("user32.dll")] public static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hwnd);
    [DllImport("user32.dll")] public static extern bool IsWindow(IntPtr hwnd);
    [DllImport("user32.dll")] public static extern bool IsWindowVisible(IntPtr hwnd);
    [DllImport("user32.dll")] public static extern bool IsIconic(IntPtr hwnd);
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hwnd, int cmd);
    [DllImport("user32.dll")] public static extern bool GetClientRect(IntPtr hwnd, out RECT rect);
    [DllImport("user32.dll")] public static extern bool ClientToScreen(IntPtr hwnd, ref POINT pt);
    [DllImport("user32.dll")] public static extern bool ScreenToClient(IntPtr hwnd, ref POINT pt);
    [DllImport("user32.dll")] public static extern bool GetCursorPos(out POINT pt);
    [DllImport("user32.dll")] public static extern bool SetCursorPos(int x, int y);
    [DllImport("user32.dll")] public static extern IntPtr WindowFromPoint(POINT pt);
    [DllImport("user32.dll")] public static extern IntPtr GetAncestor(IntPtr hwnd, uint flags);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] public static extern int GetWindowText(IntPtr hwnd, StringBuilder text, int max);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)] public static extern int GetWindowTextLength(IntPtr hwnd);
    [DllImport("user32.dll")] public static extern uint GetWindowThreadProcessId(IntPtr hwnd, out uint pid);
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vk);
    [DllImport("user32.dll")] public static extern bool EnumWindows(EnumWindowsProc callback, IntPtr lParam);
    [DllImport("user32.dll")] public static extern uint SendInput(uint count, INPUT[] inputs, int size);
    [DllImport("user32.dll")] public static extern int GetSystemMetrics(int index);
    [DllImport("user32.dll")] public static extern uint MapVirtualKey(uint code, uint mapType);
    [DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte scan, uint flags, UIntPtr extra);
    [DllImport("kernel32.dll")] public static extern IntPtr OpenProcess(uint access, bool inherit, uint pid);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)] public static extern bool QueryFullProcessImageName(IntPtr handle, uint flags, StringBuilder name, ref uint size);
    [DllImport("kernel32.dll")] public static extern bool CloseHandle(IntPtr handle);
    [DllImport("dwmapi.dll")] public static extern int DwmGetWindowAttribute(IntPtr hwnd, uint attr, out int value, uint size);
    [DllImport("shcore.dll")] public static extern int SetProcessDpiAwareness(int value);
    [DllImport("winmm.dll")] public static extern uint timeBeginPeriod(uint ms);
}

class WindowInfo
{
    public IntPtr Hwnd;
    public string Title;
    public string Exe;
}

static class Clicker
{
    const double HoverSec = 0.09;      // 누르기 전에 커서를 그 지점에 붙잡아 두는 시간 (게임이 '버튼 위'로 인식할 프레임 확보)
    const double HoldSec = 0.06;       // 짧게 누를 때(누르는 시간 0) 누르고 있는 시간 (프레임 폴링 게임 인식용)
    const double RestoreSec = 0.3;     // 최소화 복원 후 대기 (애니메이션이 끝나야 창 좌표가 확정됨)

    static readonly Stopwatch Clock = Stopwatch.StartNew();
    public static double Now { get { return Clock.Elapsed.TotalSeconds; } }

    static void Sleep(double sec) { System.Threading.Thread.Sleep((int)(sec * 1000)); }

    // ---------- 창 찾기 ----------
    static string ExeName(uint pid)
    {
        IntPtr handle = Native.OpenProcess(Native.PROCESS_QUERY_LIMITED_INFORMATION, false, pid);
        if (handle == IntPtr.Zero) return "";
        try
        {
            var buf = new StringBuilder(1024);
            uint size = (uint)buf.Capacity;
            return Native.QueryFullProcessImageName(handle, 0, buf, ref size) ? Path.GetFileName(buf.ToString()) : "";
        }
        finally { Native.CloseHandle(handle); }
    }

    // 화면에 실제로는 안 보이는 숨은 창(백그라운드 UWP 앱 등) 여부
    static bool IsCloaked(IntPtr hwnd)
    {
        int cloaked;
        Native.DwmGetWindowAttribute(hwnd, Native.DWMWA_CLOAKED, out cloaked, sizeof(int));
        return cloaked != 0;
    }

    // 제목이 있는 최상위 창 목록. 최소화된 창 포함, 이 프로그램 자신은 제외
    public static List<WindowInfo> ListWindows()
    {
        var found = new List<WindowInfo>();
        uint ownPid = (uint)Process.GetCurrentProcess().Id;
        Native.EnumWindows(delegate(IntPtr hwnd, IntPtr lParam)
        {
            int length = Native.GetWindowTextLength(hwnd);
            if (length > 0 && Native.IsWindowVisible(hwnd) && !IsCloaked(hwnd))
            {
                uint pid;
                Native.GetWindowThreadProcessId(hwnd, out pid);
                string exe = ExeName(pid);
                if (pid != ownPid && exe.Length > 0)
                {
                    var buf = new StringBuilder(length + 1);
                    Native.GetWindowText(hwnd, buf, buf.Capacity);
                    found.Add(new WindowInfo { Hwnd = hwnd, Title = buf.ToString(), Exe = exe });
                }
            }
            return true;
        }, IntPtr.Zero);
        return found;
    }

    // 저장해 둔 exe·제목으로 대상 창을 고른다.
    // 같은 exe 창이 여럿인데 제목까지 같은 창이 없으면 엉뚱한 창을 누르지 않도록 null
    public static WindowInfo MatchWindow(List<WindowInfo> windows, string exe, string title)
    {
        List<WindowInfo> sameExe = windows.FindAll(w => string.Equals(w.Exe, exe, StringComparison.OrdinalIgnoreCase));
        foreach (WindowInfo w in sameExe)
            if (w.Title == title) return w;
        return sameExe.Count == 1 ? sameExe[0] : null;
    }

    // ---------- 클릭 ----------
    // hwnd를 맨 앞 창으로. Windows는 백그라운드 프로그램의 창 전환을 막으므로 Alt 입력으로 잠금을 푼다
    static bool Activate(IntPtr hwnd)
    {
        if (Native.GetForegroundWindow() == hwnd) return true;
        Native.keybd_event(Native.VK_MENU, 0, 0, UIntPtr.Zero);
        Native.SetForegroundWindow(hwnd);
        Native.keybd_event(Native.VK_MENU, 0, Native.KEYEVENTF_KEYUP, UIntPtr.Zero);
        double deadline = Now + 0.5;
        while (Now < deadline)
        {
            if (Native.GetForegroundWindow() == hwnd) return true;
            Sleep(0.01);
        }
        return false;
    }

    // 화면 좌표 (x, y)로 커서를 옮기면서 buttonFlags(누름/뗌, 없으면 0)를 같은 순간에 처리하는 입력 1건.
    // 절대 좌표는 전체 화면(다중 모니터 포함)을 0~65535로 나눈 값으로 보낸다
    static Native.INPUT MouseAt(int x, int y, uint buttonFlags)
    {
        long left = Native.GetSystemMetrics(Native.SM_XVIRTUALSCREEN), top = Native.GetSystemMetrics(Native.SM_YVIRTUALSCREEN);
        long width = Native.GetSystemMetrics(Native.SM_CXVIRTUALSCREEN), height = Native.GetSystemMetrics(Native.SM_CYVIRTUALSCREEN);
        var input = new Native.INPUT { type = Native.INPUT_MOUSE };
        input.u.mi.dx = (int)(((x - left) * 65536 + width - 1) / width);      // 올림: 되돌려 계산하면 정확히 그 픽셀
        input.u.mi.dy = (int)(((y - top) * 65536 + height - 1) / height);
        input.u.mi.dwFlags = Native.MOUSEEVENTF_MOVE | Native.MOUSEEVENTF_ABSOLUTE | Native.MOUSEEVENTF_VIRTUALDESK | buttonFlags;
        return input;
    }

    // 키보드 키 입력 1건. 게임은 가상 키 코드가 아니라 하드웨어 스캔 코드로 키를 읽는 경우가 많아 스캔 코드로 보낸다
    static Native.INPUT Key(ushort vk, bool up)
    {
        var input = new Native.INPUT { type = Native.INPUT_KEYBOARD };
        input.u.ki.wScan = (ushort)Native.MapVirtualKey(vk, 0);      // 0 = 가상 키 → 스캔 코드
        input.u.ki.dwFlags = Native.KEYEVENTF_SCANCODE | (up ? Native.KEYEVENTF_KEYUP : 0) | (IsExtendedKey(vk) ? Native.KEYEVENTF_EXTENDEDKEY : 0);
        return input;
    }

    // 방향키·Insert/Delete/Home/End/PageUp/PageDown 등은 '확장 키' 표시가 있어야 숫자패드 키와 구분된다
    static bool IsExtendedKey(ushort vk)
    {
        return (vk >= 0x21 && vk <= 0x28) || vk == 0x2D || vk == 0x2E || vk == 0x2C || vk == 0x6F
            || vk == 0x90 || vk == 0x5B || vk == 0x5C || vk == 0x5D || vk == 0xA3 || vk == 0xA5;
    }

    static void Send(params Native.INPUT[] inputs)
    {
        Native.SendInput((uint)inputs.Length, inputs, Marshal.SizeOf(typeof(Native.INPUT)));
    }

    // sec 동안 커서를 (x, y)에 붙잡아 둔다 (사용자가 마우스를 움직여도 약 10ms마다 되돌림).
    // wiggle: 1픽셀 왕복 — 커서가 '움직였다'는 입력이 있어야 버튼 위라고 인식하는 게임 대비
    // 중간에 cancelled()가 true가 되면 false를 돌려준다
    static bool Pin(int x, int y, double sec, bool wiggle, Func<bool> cancelled)
    {
        double until = Now + sec;
        bool nudge = wiggle;
        while (Now < until)
        {
            if (cancelled()) return false;
            Send(MouseAt(x + (nudge ? 1 : 0), y, 0));
            if (wiggle) nudge = !nudge;
            Sleep(0.01);
        }
        return true;
    }

    static bool Wait(double sec, Func<bool> cancelled)
    {
        double until = Now + sec;
        while (Now < until)
        {
            if (cancelled()) return false;
            Sleep(0.01);
        }
        return true;
    }

    // 현재 마우스 위치를 대상 창 안쪽 영역 기준 비율(0~1)로. 창 밖이거나 최소화 상태면 false
    public static bool CursorRatioIn(IntPtr hwnd, out double rx, out double ry)
    {
        rx = ry = 0;
        Native.POINT pt;
        Native.GetCursorPos(out pt);
        Native.ScreenToClient(hwnd, ref pt);
        Native.RECT rect;
        Native.GetClientRect(hwnd, out rect);
        if (!(0 <= pt.X && pt.X < rect.Right && 0 <= pt.Y && pt.Y < rect.Bottom)) return false;
        rx = (double)pt.X / rect.Right;
        ry = (double)pt.Y / rect.Bottom;
        return true;
    }

    // 대상 창을 잠깐 앞으로 가져와 누르고 원래 상태로 되돌린다.
    // keyVk가 0이면 (rx, ry) 비율 지점에 마우스 왼쪽, 아니면 그 키보드 키.
    // holdSec 동안 누르고 있으며, 그 사이 cancelled()가 true가 되면 즉시 뗀다
    public static bool PressInWindow(IntPtr hwnd, double rx, double ry, ushort keyVk, double holdSec,
                                     Func<bool> cancelled, out string msg)
    {
        IntPtr prevFg = Native.GetForegroundWindow();
        Native.POINT prevPos;
        Native.GetCursorPos(out prevPos);
        bool wasMin = Native.IsIconic(hwnd);
        bool useKey = keyVk != 0;
        bool pressed = false;
        var release = new Native.INPUT();
        try
        {
            if (wasMin)
            {
                Native.ShowWindow(hwnd, Native.SW_RESTORE);
                Sleep(RestoreSec);
            }
            if (!Activate(hwnd))
            {
                msg = "대상 창을 앞으로 가져오지 못해 건너뜀";
                return false;
            }
            double hold = Math.Max(HoldSec, holdSec);
            bool finished;
            if (useKey)
            {
                // 창이 바뀐 직후 게임이 입력을 받을 준비가 되도록 잠깐 기다린다
                if (!Wait(HoverSec, cancelled))
                {
                    msg = "누르기 중단";
                    return false;
                }
                Send(Key(keyVk, false));
                release = Key(keyVk, true);
                pressed = true;
                finished = Wait(hold, cancelled);
            }
            else
            {
                Native.RECT rect;
                Native.GetClientRect(hwnd, out rect);
                var pt = new Native.POINT { X = (int)(rect.Right * rx), Y = (int)(rect.Bottom * ry) };
                Native.ClientToScreen(hwnd, ref pt);
                // 맨 앞 창이 된 직후 몇 ms 동안은 화면 겹침 순서가 아직 안 바뀌어 있으므로 기다리며 확인한다.
                // 끝까지 다른 창(항상 위 창 등)이 그 지점을 덮고 있으면 엉뚱한 창을 누르게 되므로 중단
                double deadline = Now + 0.5;
                while (Native.GetAncestor(Native.WindowFromPoint(pt), Native.GA_ROOT) != hwnd)
                {
                    if (Now > deadline)
                    {
                        msg = "클릭 지점이 다른 창에 가려져 건너뜀";
                        return false;
                    }
                    Sleep(0.01);
                }
                // 사용자가 마우스를 움직이는 중이면 누르기 직전에 커서가 밀려 엉뚱한 곳이 눌린다.
                // 그래서 '그 지점으로 이동'과 '누름/뗌'을 입력 1건에 합쳐 보낸다.
                // (이동·누름을 따로 2건으로 묶어 보내면 그 사이에 실제 마우스 움직임이 끼어드는 것을 실측함)
                if (!Pin(pt.X, pt.Y, HoverSec, true, cancelled))
                {
                    msg = "누르기 중단";
                    return false;
                }
                Send(MouseAt(pt.X, pt.Y, Native.MOUSEEVENTF_LEFTDOWN));
                release = MouseAt(pt.X, pt.Y, Native.MOUSEEVENTF_LEFTUP);
                pressed = true;
                finished = Pin(pt.X, pt.Y, hold, false, cancelled);   // 누르는 동안에도 그 지점에 붙잡아 둔다
            }
            Send(release);
            pressed = false;
            Sleep(0.05);
            if (!finished)
            {
                msg = "누르기 중단";
                return false;
            }
            if (holdSec > 0) msg = string.Format("{0}초 누르기 완료", holdSec);
            else msg = useKey ? "키 입력 완료" : "클릭 완료";
            return true;
        }
        finally
        {
            if (pressed) Send(release);      // 오류로 빠져나가도 눌린 채로 남지 않게
            if (wasMin) Native.ShowWindow(hwnd, Native.SW_MINIMIZE);
            Native.SetCursorPos(prevPos.X, prevPos.Y);
            if (prevFg != IntPtr.Zero && prevFg != hwnd && Native.IsWindow(prevFg)) Activate(prevFg);
        }
    }
}

class MainForm : Form
{
    const double RetrySec = 10;        // 클릭 실패 시 다음 간격까지 기다리지 않고 재시도하는 주기
    const double MinIntervalSec = 1;

    static readonly string ConfigPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "click_config.json");

    List<WindowInfo> windows = new List<WindowInfo>();   // 콤보박스에 표시 중인 창 목록
    string targetExe, targetTitle;                        // 대상 프로그램 (미지정이면 null)
    bool hasPos;
    double posX, posY;                                    // 창 안쪽 영역 기준 (가로 비율, 세로 비율)
    ushort keyVk;                                         // 키보드 동작일 때 누를 키 (미지정이면 0)
    bool running, capturing;
    double interval, nextDue, holdSec;
    bool keyMode;                                         // 실행 중인 동작: true = 키보드, false = 마우스
    bool busy;                                            // 누르는 중 (작업 스레드 실행 중)
    volatile bool cancel;                                 // 누르는 중 즉시 떼라는 신호
    System.Threading.Thread worker;
    readonly HashSet<int> keysDown = new HashSet<int>();
    string lastLog;

    ComboBox combo, actionCombo;
    Label posLabel, status;
    TextBox minBox, secBox, holdBox, keyBox;
    Button startBtn;
    ListBox logBox;
    readonly Timer timer = new Timer { Interval = 30 };

    public MainForm()
    {
        BuildUi();
        LoadConfig();
        UpdateActionUi();
        RefreshWindows();
        ShowPos();
        timer.Tick += delegate { OnTick(); };
        timer.Start();
        // 누르는 중에 창을 닫아도 버튼·키가 눌린 채로 남지 않게 뗄 때까지 기다린다
        FormClosing += delegate
        {
            cancel = true;
            if (worker != null && worker.IsAlive) worker.Join(2000);
        };
    }

    static Label MakeLabel(string text)
    {
        return new Label { Text = text, AutoSize = true, Anchor = AnchorStyles.Left, Margin = new Padding(0, 6, 6, 6) };
    }

    static Button MakeButton(string text)
    {
        return new Button
        {
            Text = text, AutoSize = true, UseVisualStyleBackColor = true,
            Anchor = AnchorStyles.Left | AnchorStyles.Right, Margin = new Padding(0, 3, 0, 3)
        };
    }

    void BuildUi()
    {
        SuspendLayout();
        AutoScaleDimensions = new SizeF(96F, 96F);
        AutoScaleMode = AutoScaleMode.Dpi;
        Text = "창 지정 클릭 매크로";
        Font = SystemFonts.MessageBoxFont;
        ClientSize = new Size(560, 420);
        MinimumSize = new Size(480, 380);
        Padding = new Padding(10);

        var table = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 3, RowCount = 8 };
        table.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
        table.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));
        // 버튼 열은 고정 폭: AutoSize로 두면 3열에 걸친 줄(로그·안내문)의 폭이 이 열로 몰려 가운데 열이 좁아진다
