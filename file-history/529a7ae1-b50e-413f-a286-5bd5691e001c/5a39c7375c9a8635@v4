    // ---------- 대상 창 ----------
    void RefreshWindows()
    {
        windows = Clicker.ListWindows();
        combo.Items.Clear();
        foreach (WindowInfo w in windows) combo.Items.Add(w.Title + "  ·  " + w.Exe);
        if (targetExe == null)
        {
            // 처음 실행: 로블록스가 떠 있으면 기본 선택
            foreach (WindowInfo w in windows)
            {
                if (w.Exe.StartsWith("robloxplayer", StringComparison.OrdinalIgnoreCase))
                {
                    targetExe = w.Exe;
                    targetTitle = w.Title;
                    SaveConfig();
                    break;
                }
            }
        }
        if (targetExe == null) return;
        WindowInfo match = Clicker.MatchWindow(windows, targetExe, targetTitle);
        if (match != null)
        {
            combo.SelectedIndex = windows.IndexOf(match);
        }
        else
        {
            // 목록에 없는 항목(창 목록 범위 밖 인덱스)으로 표시만 해 둔다
            combo.Items.Add(targetTitle + "  ·  " + targetExe + "  (실행 안 됨)");
            combo.SelectedIndex = combo.Items.Count - 1;
        }
    }

    void OnSelect()
    {
        int index = combo.SelectedIndex;
        if (index < 0 || index >= windows.Count) return;
        WindowInfo w = windows[index];
        if (targetExe != null && !string.Equals(targetExe, w.Exe, StringComparison.OrdinalIgnoreCase))
        {
            hasPos = false;      // 다른 프로그램이면 기존 클릭 위치는 의미가 없음
            ShowPos();
        }
        targetExe = w.Exe;
        targetTitle = w.Title;
        SaveConfig();
    }

    IntPtr FindTarget()
    {
        if (targetExe == null) return IntPtr.Zero;
        WindowInfo w = Clicker.MatchWindow(Clicker.ListWindows(), targetExe, targetTitle);
        return w != null ? w.Hwnd : IntPtr.Zero;
    }

    // ---------- 클릭 위치 ----------
    void StartCapture()
    {
        if (targetExe == null)
        {
            Log("대상 프로그램을 먼저 선택하세요");
            return;
        }
        capturing = true;
        posLabel.Text = "클릭할 곳에 마우스를 올리고 F7 …";
        posLabel.ForeColor = Color.FromArgb(0xCC, 0x66, 0x00);
    }

    void CapturePos()
    {
        IntPtr hwnd = FindTarget();
        double rx = 0, ry = 0;
        if (hwnd == IntPtr.Zero || !Clicker.CursorRatioIn(hwnd, out rx, out ry))
        {
            Log("마우스가 대상 창 안쪽에 있지 않습니다 (창이 최소화돼 있으면 띄운 뒤 다시 F7)");
            return;
        }
        posX = rx;
        posY = ry;
        hasPos = true;
        capturing = false;
        ShowPos();
        SaveConfig();
        Log("클릭 위치 저장");
    }

    // ---------- 동작(마우스/키보드) ----------
    void UpdateActionUi()
    {
        keyBox.Enabled = actionCombo.SelectedIndex == 1;
        keyBox.Text = keyVk != 0 ? KeyName(keyVk) : "여기 클릭 후 키 입력";
    }

    void SetKey(Keys code)
    {
        if (code == Keys.F7 || code == Keys.F8)
        {
            Log("F7·F8은 매크로 단축키라 지정할 수 없습니다");
            return;
        }
        keyVk = (ushort)code;
        UpdateActionUi();
        logBox.Focus();      // 다음 키 입력이 또 지정되지 않게 칸에서 빠져나온다
        SaveConfig();
        Log("키 지정: " + KeyName(keyVk));
    }

    static string KeyName(ushort vk)
    {
        var key = (Keys)vk;
        if (key >= Keys.D0 && key <= Keys.D9) return ((char)('0' + (key - Keys.D0))).ToString();
        switch (key)
        {
            case Keys.Return: return "Enter";
            case Keys.ShiftKey: return "Shift";
            case Keys.ControlKey: return "Ctrl";
            case Keys.Menu: return "Alt";
            default: return key.ToString();
        }
    }

    void ShowPos()
    {
        posLabel.Text = hasPos
            ? string.Format("창 왼쪽에서 {0:0.0}% · 위에서 {1:0.0}%", posX * 100, posY * 100)
            : "미지정";
        posLabel.ForeColor = SystemColors.ControlText;
    }

    // ---------- 실행 ----------
    static bool ParseNumber(string text, out double value)
    {
        value = 0;
        text = text.Trim();
        return text.Length == 0 || double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);
    }

    bool TryGetInterval(out double total)
    {
        total = 0;
        double min, sec;
        if (!ParseNumber(minBox.Text, out min) || !ParseNumber(secBox.Text, out sec)) return false;
        total = min * 60 + sec;
        return total >= MinIntervalSec && !double.IsInfinity(total);
    }

    bool TryGetHold(out double hold)
    {
        return ParseNumber(holdBox.Text, out hold) && hold >= 0 && !double.IsInfinity(hold);
    }

    void ToggleRun()
    {
        if (running)
        {
            running = false;
            cancel = true;       // 누르고 있는 중이면 바로 뗀다
            status.Text = "정지됨";
            status.ForeColor = Color.Gray;
            startBtn.Text = "시작 (F8)";
            Log("정지");
            return;
        }
        double total, hold;
        if (!TryGetInterval(out total))
        {
            Log(string.Format("간격은 {0}초 이상의 숫자여야 합니다", MinIntervalSec));
            return;
        }
        if (!TryGetHold(out hold))
        {
            Log("누르는 시간은 0 이상의 숫자여야 합니다");
            return;
        }
        bool useKey = actionCombo.SelectedIndex == 1;
        if (targetExe == null)
        {
            Log("대상 프로그램을 먼저 선택하세요");
            return;
        }
        if (useKey && keyVk == 0)
        {
            Log("누를 키를 먼저 지정하세요");
            return;
        }
        if (!useKey && !hasPos)
        {
            Log("클릭 위치를 먼저 지정하세요");
            return;
        }
        interval = total;
        holdSec = hold;
        keyMode = useKey;
        cancel = false;
        running = true;
        nextDue = Clicker.Now + 1.0;     // 시작 직후 1회 클릭해 동작을 바로 확인
        startBtn.Text = "정지 (F8)";
        SaveConfig();
        Log("시작");
    }

    static bool IsDown(int vk)
    {
        return (Native.GetAsyncKeyState(vk) & 0x8000) != 0;
    }

    void Fire()
    {
        // 마우스 버튼을 누르고 있는 중(드래그 등)이면 끝날 때까지 미룬다
        if (IsDown(0x01) || IsDown(0x02) || IsDown(0x04))
        {
            nextDue = Clicker.Now + 0.5;
            return;
        }
        IntPtr hwnd = FindTarget();
        if (hwnd == IntPtr.Zero)
        {
            Finish(false, "대상 창을 찾지 못해 건너뜀");
            return;
        }
        // 길게 누르는 동안에도 창이 멈추지 않고 F8을 받을 수 있게 누르기는 별도 스레드에서 한다
        double rx = posX, ry = posY, hold = holdSec;
        ushort vk = keyMode ? keyVk : (ushort)0;
        busy = true;
        worker = new System.Threading.Thread(delegate()
        {
            bool ok;
            string msg;
            try { ok = Clicker.PressInWindow(hwnd, rx, ry, vk, hold, () => cancel, out msg); }
            catch (Exception e) { ok = false; msg = "오류: " + e.Message; }
            try { BeginInvoke((Action)delegate { busy = false; Finish(ok, msg); }); }
            catch (InvalidOperationException) { }    // 창이 닫히는 중
        });
        worker.IsBackground = true;
        worker.Start();
    }

    void Finish(bool ok, string msg)
    {
        Log(msg);
        nextDue = Clicker.Now + (ok ? interval : Math.Min(interval, RetrySec));
    }

    // 키가 '방금 눌린' 순간에만 true (누르고 있는 동안 반복 발동 방지)
    bool Pressed(int vk)
    {
        bool down = IsDown(vk);
        bool wasDown = keysDown.Contains(vk);
        if (down) keysDown.Add(vk);
        else keysDown.Remove(vk);
        return down && !wasDown;
    }

    void OnTick()
    {
        try
        {
            if (Pressed(Native.VK_TOGGLE)) ToggleRun();
            if (Pressed(Native.VK_CAPTURE) && capturing) CapturePos();
            if (running && busy)
            {
                SetStatus("누르는 중 · F8로 바로 멈춤");
            }
            else if (running)
            {
                double remain = nextDue - Clicker.Now;
                if (remain <= 0) Fire();
                else SetStatus(string.Format("실행 중 · 다음 입력까지 {0}:{1:00}", (int)remain / 60, (int)remain % 60));
            }
        }
        catch (Exception e)
        {
            Log("오류: " + e.Message);   // 한 번 오류가 나도 반복은 계속
        }
    }

    // ---------- 헬퍼 ----------
    void SetStatus(string text)
    {
        if (status.Text == text) return;
        status.Text = text;
        status.ForeColor = Color.Green;
    }

    void Log(string msg)
    {
        if (msg == lastLog && logBox.Items.Count > 0)
            logBox.Items.RemoveAt(logBox.Items.Count - 1);   // 같은 메시지 반복(재시도 등)은 마지막 줄 시각만 갱신
        lastLog = msg;
        logBox.Items.Add(DateTime.Now.ToString("HH:mm:ss") + "  " + msg);
        if (logBox.Items.Count > 200) logBox.Items.RemoveAt(0);
        logBox.TopIndex = logBox.Items.Count - 1;
    }

    // ---------- 설정 저장/로드 ----------
    void SaveConfig()
    {
        var data = new Dictionary<string, object>();
        data["target"] = targetExe == null
            ? null
            : new Dictionary<string, object> { { "exe", targetExe }, { "title", targetTitle } };
        data["pos"] = hasPos ? new double[] { posX, posY } : null;
        data["min"] = minBox.Text;
        data["sec"] = secBox.Text;
        data["action"] = actionCombo.SelectedIndex == 1 ? "key" : "mouse";
        data["key"] = (int)keyVk;
        data["hold"] = holdBox.Text;
        try
        {
            File.WriteAllText(ConfigPath, new JavaScriptSerializer().Serialize(data), new UTF8Encoding(false));
        }
        catch (Exception e)
        {
            Log("설정 저장 실패: " + e.Message);
        }
    }

    void LoadConfig()
    {
        if (!File.Exists(ConfigPath)) return;
        try
        {
            var data = new JavaScriptSerializer().Deserialize<Dictionary<string, object>>(File.ReadAllText(ConfigPath, Encoding.UTF8));
            object value;
            var target = data.TryGetValue("target", out value) ? value as Dictionary<string, object> : null;
            if (target != null)
            {
                targetExe = (string)target["exe"];
                targetTitle = (string)target["title"];
            }
            var pos = data.TryGetValue("pos", out value) ? value as IList : null;
            if (pos != null)
            {
                posX = Convert.ToDouble(pos[0], CultureInfo.InvariantCulture);
                posY = Convert.ToDouble(pos[1], CultureInfo.InvariantCulture);
                hasPos = true;
            }
            if (data.TryGetValue("min", out value) && value != null) minBox.Text = Convert.ToString(value, CultureInfo.InvariantCulture);
            if (data.TryGetValue("sec", out value) && value != null) secBox.Text = Convert.ToString(value, CultureInfo.InvariantCulture);
            if (data.TryGetValue("action", out value) && "key".Equals(value)) actionCombo.SelectedIndex = 1;
            if (data.TryGetValue("key", out value) && value != null) keyVk = (ushort)Convert.ToInt32(value, CultureInfo.InvariantCulture);
            if (data.TryGetValue("hold", out value) && value != null) holdBox.Text = Convert.ToString(value, CultureInfo.InvariantCulture);
        }
        catch (Exception)
        {
            Log("설정 파일을 읽지 못해 기본값으로 시작");
        }
    }

    [STAThread]
    static void Main()
    {
        // 좌표를 실제 픽셀로 다루기 위해 창을 만들기 전에 DPI 인식 설정 (지원 안 하는 Windows면 건너뜀)
        try { Native.SetProcessDpiAwareness(2); }
        catch (Exception) { }
        // 기본 타이머는 15ms 단위라 짧은 대기가 늘어진다 → 1ms 단위로 (창을 꺼내 두는 시간 단축)
        try { Native.timeBeginPeriod(1); }
        catch (Exception) { }
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);
        Application.Run(new MainForm());
    }
