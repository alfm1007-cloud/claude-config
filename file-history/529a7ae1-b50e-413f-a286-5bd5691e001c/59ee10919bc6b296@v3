"""
창 지정 클릭 매크로 — 지정한 프로그램 창의 한 지점을 일정 간격마다 클릭
- 다른 작업 중에도 동작: 클릭 순간에만 대상 창을 앞으로 → 클릭 → 원래 창·마우스 위치로 복귀
- 대상 창이 최소화돼 있으면 잠깐 복원했다가 다시 최소화
- 의존성 없음 (tkinter + ctypes, Windows 전용). 더블클릭으로 실행

주의: 온라인 게임은 자동 입력을 이용약관으로 금지하는 경우가 있습니다. 허용 여부는 본인 확인.
"""

import ctypes
import json
import os
import time
import tkinter as tk
from ctypes import wintypes
from tkinter import ttk

_BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATH = os.path.join(_BASE_DIR, "click_config.json")

VK_TOGGLE = 0x77          # F8: 시작/정지
VK_CAPTURE = 0x76         # F7: 클릭 위치 저장
HOLD_SEC = 0.06           # 버튼을 누르고 있는 시간 (프레임 폴링 게임 인식용)
RESTORE_SEC = 0.3         # 최소화 복원 후 대기 (애니메이션이 끝나야 창 좌표가 확정됨)
RETRY_SEC = 10            # 클릭 실패 시 다음 간격까지 기다리지 않고 재시도하는 주기
MIN_INTERVAL_SEC = 1

VK_MENU = 0x12
KEYEVENTF_KEYUP = 0x0002
MOUSEEVENTF_MOVE = 0x0001
MOUSEEVENTF_LEFTDOWN = 0x0002
MOUSEEVENTF_LEFTUP = 0x0004
SW_MINIMIZE = 6
SW_RESTORE = 9
GA_ROOT = 2
DWMWA_CLOAKED = 14
PROCESS_QUERY_LIMITED_INFORMATION = 0x1000

# 좌표를 실제 픽셀로 다루기 위해 창을 만들기 전에 DPI 인식 설정
try:
    ctypes.windll.shcore.SetProcessDpiAwareness(2)
except (AttributeError, OSError):
    pass

user32 = ctypes.WinDLL("user32", use_last_error=True)
kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
dwmapi = ctypes.WinDLL("dwmapi")

WNDENUMPROC = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)


def _sig(func, restype, *argtypes):
    func.restype, func.argtypes = restype, argtypes


# 64비트에서 창 핸들이 잘리지 않도록 시그니처 명시
_sig(user32.GetForegroundWindow, wintypes.HWND)
_sig(user32.SetForegroundWindow, wintypes.BOOL, wintypes.HWND)
_sig(user32.IsWindow, wintypes.BOOL, wintypes.HWND)
_sig(user32.IsWindowVisible, wintypes.BOOL, wintypes.HWND)
_sig(user32.IsIconic, wintypes.BOOL, wintypes.HWND)
_sig(user32.ShowWindow, wintypes.BOOL, wintypes.HWND, ctypes.c_int)
_sig(user32.GetClientRect, wintypes.BOOL, wintypes.HWND, ctypes.POINTER(wintypes.RECT))
_sig(user32.ClientToScreen, wintypes.BOOL, wintypes.HWND, ctypes.POINTER(wintypes.POINT))
_sig(user32.ScreenToClient, wintypes.BOOL, wintypes.HWND, ctypes.POINTER(wintypes.POINT))
_sig(user32.GetCursorPos, wintypes.BOOL, ctypes.POINTER(wintypes.POINT))
_sig(user32.SetCursorPos, wintypes.BOOL, ctypes.c_int, ctypes.c_int)
_sig(user32.WindowFromPoint, wintypes.HWND, wintypes.POINT)
_sig(user32.GetAncestor, wintypes.HWND, wintypes.HWND, wintypes.UINT)
_sig(user32.GetWindowTextW, ctypes.c_int, wintypes.HWND, wintypes.LPWSTR, ctypes.c_int)
_sig(user32.GetWindowTextLengthW, ctypes.c_int, wintypes.HWND)
_sig(user32.GetWindowThreadProcessId, wintypes.DWORD, wintypes.HWND, ctypes.POINTER(wintypes.DWORD))
_sig(user32.GetAsyncKeyState, ctypes.c_short, ctypes.c_int)
_sig(user32.EnumWindows, wintypes.BOOL, WNDENUMPROC, wintypes.LPARAM)
_sig(user32.mouse_event, None, wintypes.DWORD, ctypes.c_long, ctypes.c_long, wintypes.DWORD, ctypes.c_size_t)
_sig(user32.keybd_event, None, wintypes.BYTE, wintypes.BYTE, wintypes.DWORD, ctypes.c_size_t)
_sig(kernel32.OpenProcess, wintypes.HANDLE, wintypes.DWORD, wintypes.BOOL, wintypes.DWORD)
_sig(kernel32.QueryFullProcessImageNameW, wintypes.BOOL, wintypes.HANDLE, wintypes.DWORD,
     wintypes.LPWSTR, ctypes.POINTER(wintypes.DWORD))
_sig(kernel32.CloseHandle, wintypes.BOOL, wintypes.HANDLE)
_sig(dwmapi.DwmGetWindowAttribute, ctypes.c_long, wintypes.HWND, wintypes.DWORD,
     ctypes.c_void_p, wintypes.DWORD)


# ---------- 창 찾기 ----------
def _pid_of(hwnd):
    pid = wintypes.DWORD()
    user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
    return pid.value


def _exe_name(pid):
    handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
    if not handle:
        return ""
    try:
        buf = ctypes.create_unicode_buffer(1024)
        size = wintypes.DWORD(len(buf))
        if kernel32.QueryFullProcessImageNameW(handle, 0, buf, ctypes.byref(size)):
            return os.path.basename(buf.value)
        return ""
    finally:
        kernel32.CloseHandle(handle)


def _is_cloaked(hwnd):
    """화면에 실제로는 안 보이는 숨은 창(백그라운드 UWP 앱 등) 여부."""
    cloaked = wintypes.DWORD()
    dwmapi.DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, ctypes.byref(cloaked), ctypes.sizeof(cloaked))
    return bool(cloaked.value)


def list_windows():
    """제목이 있는 최상위 창 목록 [(hwnd, 제목, exe)]. 최소화된 창 포함, 이 프로그램 자신은 제외."""
    found = []
    own_pid = os.getpid()

    def on_window(hwnd, _):
        length = user32.GetWindowTextLengthW(hwnd)
        if length and user32.IsWindowVisible(hwnd) and not _is_cloaked(hwnd):
            pid = _pid_of(hwnd)
            exe = _exe_name(pid)
            if pid != own_pid and exe:
                buf = ctypes.create_unicode_buffer(length + 1)
                user32.GetWindowTextW(hwnd, buf, length + 1)
                found.append((hwnd, buf.value, exe))
        return True

    user32.EnumWindows(WNDENUMPROC(on_window), 0)
    return found


def match_window(windows, exe, title):
    """저장해 둔 exe·제목으로 대상 창을 고른다.
    같은 exe 창이 여럿인데 제목까지 같은 창이 없으면 엉뚱한 창을 누르지 않도록 None."""
    same_exe = [w for w in windows if w[2].lower() == exe.lower()]
    for w in same_exe:
        if w[1] == title:
            return w
    return same_exe[0] if len(same_exe) == 1 else None


# ---------- 클릭 ----------
def _activate(hwnd):
    """hwnd를 맨 앞 창으로. Windows는 백그라운드 프로그램의 창 전환을 막으므로 Alt 입력으로 잠금을 푼다."""
    if user32.GetForegroundWindow() == hwnd:
        return True
    user32.keybd_event(VK_MENU, 0, 0, 0)
    user32.SetForegroundWindow(hwnd)
    user32.keybd_event(VK_MENU, 0, KEYEVENTF_KEYUP, 0)
    deadline = time.monotonic() + 0.5
    while time.monotonic() < deadline:
        if user32.GetForegroundWindow() == hwnd:
            return True
        time.sleep(0.01)
    return False


def cursor_ratio_in(hwnd):
    """현재 마우스 위치를 대상 창 안쪽 영역 기준 비율(0~1)로. 창 밖이거나 최소화 상태면 None."""
    pt = wintypes.POINT()
    user32.GetCursorPos(ctypes.byref(pt))
    user32.ScreenToClient(hwnd, ctypes.byref(pt))
    rect = wintypes.RECT()
    user32.GetClientRect(hwnd, ctypes.byref(rect))
    if not (0 <= pt.x < rect.right and 0 <= pt.y < rect.bottom):
        return None
    return pt.x / rect.right, pt.y / rect.bottom


def click_in_window(hwnd, rx, ry):
    """대상 창을 잠깐 앞으로 가져와 (rx, ry) 비율 지점을 클릭하고 원래 상태로 되돌린다. (성공여부, 메시지)"""
    prev_fg = user32.GetForegroundWindow()
    prev_pos = wintypes.POINT()
    user32.GetCursorPos(ctypes.byref(prev_pos))
    was_min = bool(user32.IsIconic(hwnd))
    try:
        if was_min:
            user32.ShowWindow(hwnd, SW_RESTORE)
            time.sleep(RESTORE_SEC)
        if not _activate(hwnd):
            return False, "대상 창을 앞으로 가져오지 못해 건너뜀"
        rect = wintypes.RECT()
        user32.GetClientRect(hwnd, ctypes.byref(rect))
        pt = wintypes.POINT(int(rect.right * rx), int(rect.bottom * ry))
        user32.ClientToScreen(hwnd, ctypes.byref(pt))
        # 맨 앞 창이 된 직후 몇 ms 동안은 화면 겹침 순서가 아직 안 바뀌어 있으므로 기다리며 확인한다.
        # 끝까지 다른 창(항상 위 창 등)이 그 지점을 덮고 있으면 엉뚱한 창을 누르게 되므로 중단
        deadline = time.monotonic() + 0.5
        while user32.GetAncestor(user32.WindowFromPoint(pt), GA_ROOT) != hwnd:
            if time.monotonic() > deadline:
                return False, "클릭 지점이 다른 창에 가려져 건너뜀"
            time.sleep(0.01)
        user32.SetCursorPos(pt.x, pt.y)
        time.sleep(0.03)
        # 커서가 '움직였다'는 입력이 있어야 버튼 위에 있다고 인식하는 게임이 있어 1픽셀 흔든다
        user32.mouse_event(MOUSEEVENTF_MOVE, 1, 0, 0, 0)
        time.sleep(0.03)
        user32.mouse_event(MOUSEEVENTF_MOVE, -1, 0, 0, 0)
        time.sleep(0.03)
        user32.mouse_event(MOUSEEVENTF_LEFTDOWN, 0, 0, 0, 0)
        time.sleep(HOLD_SEC)
        user32.mouse_event(MOUSEEVENTF_LEFTUP, 0, 0, 0, 0)
        time.sleep(0.05)
        return True, "클릭 완료"
    finally:
        if was_min:
            user32.ShowWindow(hwnd, SW_MINIMIZE)
        user32.SetCursorPos(prev_pos.x, prev_pos.y)
        if prev_fg and prev_fg != hwnd and user32.IsWindow(prev_fg):
            _activate(prev_fg)


# ---------- GUI ----------
class ClickApp:
    def __init__(self, root):
        self.root = root
        self.root.title("창 지정 클릭 매크로")

        self.windows = []        # 콤보박스에 표시 중인 창 목록 [(hwnd, 제목, exe)]
        self.target = None       # {"exe": ..., "title": ...}
        self.pos = None          # 창 안쪽 영역 기준 (가로 비율, 세로 비율)
        self.running = False
        self.capturing = False
        self.interval = 0.0
        self.next_due = 0.0
        self._keys_down = set()
        self._last_log = None

        self._build_ui()
        self._load_config()
        self.refresh_windows()
        self._show_pos()
        self._tick()

    def _build_ui(self):
        frm = ttk.Frame(self.root, padding=10)
        frm.pack(fill="both", expand=True)
        frm.columnconfigure(1, weight=1)
        frm.rowconfigure(4, weight=1)

        ttk.Label(frm, text="대상 프로그램").grid(row=0, column=0, sticky="w", pady=4)
        self.combo = ttk.Combobox(frm, state="readonly", width=46)
        self.combo.grid(row=0, column=1, sticky="ew", padx=6)
        self.combo.bind("<<ComboboxSelected>>", self._on_select)
        ttk.Button(frm, text="새로고침", command=self.refresh_windows).grid(row=0, column=2)

        ttk.Label(frm, text="클릭 위치").grid(row=1, column=0, sticky="w", pady=4)
        self.pos_label = ttk.Label(frm)
        self.pos_label.grid(row=1, column=1, sticky="w", padx=6)
        ttk.Button(frm, text="위치 지정", command=self.start_capture).grid(row=1, column=2)

        ttk.Label(frm, text="간격").grid(row=2, column=0, sticky="w", pady=4)
        iv = ttk.Frame(frm)
        iv.grid(row=2, column=1, sticky="w", padx=6)
        self.min_var = tk.StringVar(value="15")
        self.sec_var = tk.StringVar(value="0")
        ttk.Entry(iv, textvariable=self.min_var, width=6).pack(side="left")
        ttk.Label(iv, text="분").pack(side="left", padx=(2, 10))
        ttk.Entry(iv, textvariable=self.sec_var, width=6).pack(side="left")
        ttk.Label(iv, text="초").pack(side="left", padx=2)

        run = ttk.Frame(frm)
        run.grid(row=3, column=0, columnspan=3, sticky="w", pady=(8, 0))
        self.start_btn = ttk.Button(run, text="시작 (F8)", command=self.toggle_run)
        self.start_btn.pack(side="left")
        self.status = ttk.Label(run, text="정지됨", foreground="gray")
        self.status.pack(side="left", padx=10)

        self.log_box = tk.Listbox(frm, height=8)
        self.log_box.grid(row=4, column=0, columnspan=3, sticky="nsew", pady=(8, 0))

        ttk.Label(frm, foreground="gray",
                  text="전역 핫키: F8 시작/정지 · 위치 지정은 버튼을 누른 뒤 "
                       "클릭할 곳에 마우스를 올리고 F7").grid(row=5, column=0, columnspan=3,
                                                    sticky="w", pady=(8, 0))

    # ---------- 대상 창 ----------
    def refresh_windows(self):
        self.windows = list_windows()
        self.combo["values"] = [f"{title}  ·  {exe}" for _, title, exe in self.windows]
        if self.target is None:
            # 처음 실행: 로블록스가 떠 있으면 기본 선택
            for w in self.windows:
                if w[2].lower().startswith("robloxplayer"):
                    self.target = {"exe": w[2], "title": w[1]}
                    self._save_config()
                    break
        if self.target is None:
            self.combo.set("")
            return
        w = match_window(self.windows, self.target["exe"], self.target["title"])
        if w:
            self.combo.current(self.windows.index(w))
        else:
            self.combo.set(f"{self.target['title']}  ·  {self.target['exe']}  (실행 안 됨)")

    def _on_select(self, _event):
        _, title, exe = self.windows[self.combo.current()]
        if self.target and self.target["exe"].lower() != exe.lower():
            self.pos = None      # 다른 프로그램이면 기존 클릭 위치는 의미가 없음
            self._show_pos()
        self.target = {"exe": exe, "title": title}
        self._save_config()

    def _find_target(self):
        if not self.target:
            return None
        w = match_window(list_windows(), self.target["exe"], self.target["title"])
        return w[0] if w else None

    # ---------- 클릭 위치 ----------
    def start_capture(self):
        if not self.target:
            self.log("대상 프로그램을 먼저 선택하세요")
            return
        self.capturing = True
        self.pos_label.config(text="클릭할 곳에 마우스를 올리고 F7 …", foreground="#c60")

    def _capture(self):
        hwnd = self._find_target()
        ratio = cursor_ratio_in(hwnd) if hwnd else None
        if ratio is None:
            self.log("마우스가 대상 창 안쪽에 있지 않습니다 (창이 최소화돼 있으면 띄운 뒤 다시 F7)")
            return
        self.pos = ratio
        self.capturing = False
        self._show_pos()
        self._save_config()
        self.log("클릭 위치 저장")

    def _show_pos(self):
        if self.pos:
            text = f"창 왼쪽에서 {self.pos[0]:.1%} · 위에서 {self.pos[1]:.1%}"
        else:
            text = "미지정"
        self.pos_label.config(text=text, foreground="")

    # ---------- 실행 ----------
    def _interval_sec(self):
        try:
            total = float(self.min_var.get() or 0) * 60 + float(self.sec_var.get() or 0)
        except ValueError:
            return None
        return total if total >= MIN_INTERVAL_SEC else None

    def toggle_run(self):
        if self.running:
            self.running = False
            self.status.config(text="정지됨", foreground="gray")
            self.start_btn.config(text="시작 (F8)")
            self.log("정지")
            return
        interval = self._interval_sec()
        if interval is None:
            self.log(f"간격은 {MIN_INTERVAL_SEC}초 이상의 숫자여야 합니다")
            return
        if not self.target or not self.pos:
            self.log("대상 프로그램과 클릭 위치를 먼저 지정하세요")
            return
        self.interval = interval
        self.running = True
        self.next_due = time.monotonic() + 1.0   # 시작 직후 1회 클릭해 동작을 바로 확인
        self.start_btn.config(text="정지 (F8)")
        self._save_config()
        self.log("시작")

    def _fire(self):
        # 마우스 버튼을 누르고 있는 중(드래그 등)이면 끝날 때까지 미룬다
        if any(user32.GetAsyncKeyState(vk) & 0x8000 for vk in (0x01, 0x02, 0x04)):
            self.next_due = time.monotonic() + 0.5
            return
        hwnd = self._find_target()
        if hwnd is None:
            ok, msg = False, "대상 창을 찾지 못해 건너뜀"
        else:
            ok, msg = click_in_window(hwnd, *self.pos)
        self.log(msg)
        self.next_due = time.monotonic() + (self.interval if ok else min(self.interval, RETRY_SEC))

    def _pressed(self, vk):
        """키가 '방금 눌린' 순간에만 True (누르고 있는 동안 반복 발동 방지)."""
        down = bool(user32.GetAsyncKeyState(vk) & 0x8000)
        was_down = vk in self._keys_down
        if down:
            self._keys_down.add(vk)
        else:
            self._keys_down.discard(vk)
        return down and not was_down

    def _tick(self):
        try:
            if self._pressed(VK_TOGGLE):
                self.toggle_run()
            if self._pressed(VK_CAPTURE) and self.capturing:
                self._capture()
            if self.running:
                remain = self.next_due - time.monotonic()
                if remain <= 0:
                    self._fire()
                else:
                    text = f"실행 중 · 다음 클릭까지 {int(remain) // 60}:{int(remain) % 60:02d}"
                    if self.status.cget("text") != text:
                        self.status.config(text=text, foreground="green")
        finally:
            self.root.after(30, self._tick)   # 한 번 오류가 나도 반복은 계속

    # ---------- 헬퍼 ----------
    def log(self, msg):
        line = f"{time.strftime('%H:%M:%S')}  {msg}"
        if msg == self._last_log:
            self.log_box.delete("end")   # 같은 메시지 반복(재시도 등)은 마지막 줄 시각만 갱신
        self._last_log = msg
        self.log_box.insert("end", line)
        if self.log_box.size() > 200:
            self.log_box.delete(0)
        self.log_box.see("end")

    # ---------- 설정 저장/로드 ----------
    def _save_config(self):
        data = {"target": self.target, "pos": self.pos,
                "min": self.min_var.get(), "sec": self.sec_var.get()}
        try:
            with open(CONFIG_PATH, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except OSError as e:
            self.log(f"설정 저장 실패: {e}")

    def _load_config(self):
        if not os.path.exists(CONFIG_PATH):
            return
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
            self.target = data.get("target")
            self.pos = tuple(data["pos"]) if data.get("pos") else None
            self.min_var.set(data.get("min", "15"))
            self.sec_var.set(data.get("sec", "0"))
        except (OSError, ValueError, TypeError, KeyError):
            self.log("설정 파일을 읽지 못해 기본값으로 시작")


def main():
    root = tk.Tk()
    app = ClickApp(root)
    # 콘솔 없이 실행되므로 예외는 화면 로그로 보여 준다
    root.report_callback_exception = lambda exc_type, exc, tb: app.log(f"오류: {exc!r}")
    root.mainloop()


if __name__ == "__main__":
    main()
